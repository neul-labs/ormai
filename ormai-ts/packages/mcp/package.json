{
  "name": "@ormai/mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server for OrmAI — expose database tools to AI agents via MCP",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "orm",
    "ai",
    "agents",
    "mcp",
    "model-context-protocol",
    "database",
    "policy",
    "audit",
    "security",
    "llm-tools"
  ],
  "author": "Neul Labs <contact@neullabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neul-labs/ormai",
    "directory": "ormai-ts/packages/mcp"
  },
  "homepage": "https://docs.neullabs.com/ormai",
  "bugs": {
    "url": "https://github.com/neul-labs/ormai/issues"
  },
  "dependencies": {
    "@ormai/core": "*",
    "zod-to-json-schema": "^3.23.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
