{
  "name": "@ormai/prisma",
  "version": "0.1.1",
  "description": "Prisma ORM adapter for OrmAI — policy-governed database access for AI agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "orm",
    "ai",
    "agents",
    "prisma",
    "agent-tools",
    "database",
    "policy",
    "audit",
    "security",
    "tenant-isolation",
    "multi-tenant",
    "data-governance",
    "llm-tools"
  ],
  "author": "Neul Labs <contact@neullabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neul-labs/ormai",
    "directory": "ormai-ts/packages/prisma"
  },
  "homepage": "https://docs.neullabs.com/ormai",
  "bugs": {
    "url": "https://github.com/neul-labs/ormai/issues"
  },
  "dependencies": {
    "@ormai/core": "*"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
