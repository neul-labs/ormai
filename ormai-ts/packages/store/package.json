{
  "name": "@ormai/store",
  "version": "0.1.1",
  "description": "Audit logging stores for OrmAI — in-memory, JSONL, and middleware",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "orm",
    "ai",
    "agents",
    "audit",
    "logging",
    "database",
    "policy",
    "llm-tools"
  ],
  "author": "Dipankar Sarkar <me@dipankar.name>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neul-labs/ormai",
    "directory": "ormai-ts/packages/store"
  },
  "homepage": "https://github.com/neul-labs/ormai/tree/main/ormai-ts/packages/store",
  "bugs": {
    "url": "https://github.com/neul-labs/ormai/issues"
  },
  "dependencies": {
    "@ormai/core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
