{
  "name": "@ormai/typeorm",
  "version": "0.1.0",
  "description": "TypeORM adapter for OrmAI — policy-governed database access for AI agents",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "orm", "ai", "agents", "typeorm", "agent-tools",
    "database", "policy", "audit", "security", "tenant-isolation",
    "multi-tenant", "data-governance", "llm-tools"
  ],
  "author": "Dipankar Sarkar <me@dipankar.name>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neul-labs/ormai",
    "directory": "ormai-ts/packages/typeorm"
  },
  "homepage": "https://github.com/neul-labs/ormai/tree/main/ormai-ts/packages/typeorm",
  "bugs": {
    "url": "https://github.com/neul-labs/ormai/issues"
  },
  "dependencies": {
    "@ormai/core": "*"
  },
  "peerDependencies": {
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}